NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Runtime uses the signed-in user's token and RLS, not a service-role key.
GEMINI_API_KEY=server-only-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash

# Prototype mode: run the app on hardcoded fixtures with no Supabase/Gemini backend.
# Set to 1 for a demo build/deploy. Left unset, a local dev run with no Supabase configured
# also falls back to prototype mode; a production build never does (missing Supabase vars
# fail as normal there, so a misconfigured prod deploy cannot bypass auth).
NEXT_PUBLIC_PROTOTYPE=

# Optional: a Google Maps API key for the prototype route map (/trips/[id]/map). When set, the
# selected day's stops are routed by the Google Directions API and drawn on a real interactive
# map with a turn-by-turn steps panel; without it, a stylised fallback canvas is shown.
# Enable "Maps JavaScript API" and "Directions API" on the key/project (both have a generous
# free monthly credit), plus "Street View Static API" for the corner street-view preview card
# (without it that card just hides itself; the full Street View panorama still works, since
# panoramas ship with the Maps JavaScript API). This key is exposed to the browser, so restrict it by HTTP
# referrer in the Google Cloud console (e.g. http://localhost:*/* for local, plus your deploy
# domain). Setting it also adds Google's map hosts to the CSP (script/img/connect/font/frame),
# all Google-owned, never a wildcard.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
